# No java: — the test VM is the same as the build's. A fixed path would
# only be valid on one machine; the minimum version a run requires is
# recorded as jdk.run.minimum in the POM.
-tester: biz.aQute.tester.junit-platform

-runee: JavaSE-11

-resolve.effective: active

-runvm: ${def;argLine}, -Djava.security.manager=allow

-runproperties: \
	org.osgi.test.cases.bundle.annotations.bundle.symbolic.name=org.osgi.impl.bundle.annotations

-runfw: org.eclipse.osgi


# API overlays on the framework classpath (exports become system packages)
-runpath: \


# This will help us keep -runbundles sorted
-runstartlevel: \
    order=sortbynameversion,\
    begin=-1

-runrequires: \
	bnd.identity;id='org.osgi.test.cases.bundle.annotations',\
	bnd.identity;id='org.osgi.impl.bundle.annotations',\
	bnd.identity;id='junit-jupiter-api';version='[5.12.2,5.12.3)',\
	bnd.identity;id='junit-jupiter-engine';version='[5.12.2,5.12.3)',\
	bnd.identity;id='junit-jupiter-params';version='[5.12.2,5.12.3)',\
	bnd.identity;id='junit-platform-commons';version='[1.12.2,1.12.3)',\
	bnd.identity;id='junit-platform-engine';version='[1.12.2,1.12.3)',\
	bnd.identity;id='junit-platform-launcher';version='[1.12.2,1.12.3)',\
	bnd.identity;id='org.opentest4j';version='[1.3.0,1.3.1)',\
	bnd.identity;id='assertj-core';version='[3.27.7,3.27.8)',\
	bnd.identity;id='junit-jupiter-api';version='[5.12.2,5.12.3)',\
	bnd.identity;id='junit-jupiter-engine';version='[5.12.2,5.12.3)',\
	bnd.identity;id='junit-jupiter-params';version='[5.12.2,5.12.3)',\
	bnd.identity;id='junit-platform-commons';version='[1.12.2,1.12.3)',\
	bnd.identity;id='junit-platform-engine';version='[1.12.2,1.12.3)',\
	bnd.identity;id='junit-platform-launcher';version='[1.12.2,1.12.3)',\
	bnd.identity;id='junit-vintage-engine';version='[5.12.2,5.12.3)',\
	bnd.identity;id='org.hamcrest';version='[2.2.0,2.2.1)',\
	bnd.identity;id='org.awaitility';version='[4.2.0,4.2.1)',\
	bnd.identity;id='org.apache.servicemix.bundles.junit';version='[4.13.2.1,4.13.2.2)',\
	bnd.identity;id='org.opentest4j';version='[1.3.0,1.3.1)',\
	bnd.identity;id='org.osgi.test.common';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.assertj.framework';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.junit5';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.junit4';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.mockito.mockito-core';version='[4.6.1,4.6.2)',\
	bnd.identity;id='net.bytebuddy.byte-buddy';version='[1.18.3,1.18.4)',\
	bnd.identity;id='net.bytebuddy.byte-buddy-agent';version='[1.18.3,1.18.4)',\
	bnd.identity;id='org.objenesis'

# Test infrastructure for the junit-platform tester — mirrors the original
# cnf/repo/osgi.tck.junit-platform lib that every TCK run carried
-runbundles.tck: \
	assertj-core;version='[3.27.7,3.27.8)',\
	junit-jupiter-api;version='[5.12.2,5.12.3)',\
	junit-jupiter-engine;version='[5.12.2,5.12.3)',\
	junit-jupiter-params;version='[5.12.2,5.12.3)',\
	junit-platform-commons;version='[1.12.2,1.12.3)',\
	junit-platform-engine;version='[1.12.2,1.12.3)',\
	junit-platform-launcher;version='[1.12.2,1.12.3)',\
	junit-vintage-engine;version='[5.12.2,5.12.3)',\
	org.hamcrest;version='[2.2.0,2.2.1)',\
	org.awaitility;version='[4.2.0,4.2.1)',\
	org.apache.servicemix.bundles.junit;version='[4.13.2.1,4.13.2.2)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.test.common;version='[1.2.0,1.2.1)',\
	org.osgi.test.assertj.framework;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit5;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit4;version='[1.2.0,1.2.1)',\
	org.mockito.mockito-core;version='[4.6.1,4.6.2)',\
	net.bytebuddy.byte-buddy;version='[1.18.3,1.18.4)',\
	net.bytebuddy.byte-buddy-agent;version='[1.18.3,1.18.4)',\
	org.objenesis


# -runbundles is committed and verified by the build; after a dependency
# change update it with:
#   mvn biz.aQute.bnd:bnd-resolver-maven-plugin:6.4.0:resolve
-runbundles: \
	assertj-core;version='[3.27.7,3.27.8)',\
	junit-jupiter-api;version='[5.12.2,5.12.3)',\
	junit-jupiter-engine;version='[5.12.2,5.12.3)',\
	junit-jupiter-params;version='[5.12.2,5.12.3)',\
	junit-platform-commons;version='[1.12.2,1.12.3)',\
	junit-platform-engine;version='[1.12.2,1.12.3)',\
	junit-platform-launcher;version='[1.12.2,1.12.3)',\
	junit-vintage-engine;version='[5.12.2,5.12.3)',\
	net.bytebuddy.byte-buddy;version='[1.18.3,1.18.4)',\
	net.bytebuddy.byte-buddy-agent;version='[1.18.3,1.18.4)',\
	org.apache.servicemix.bundles.junit;version='[4.13.2,4.13.3)',\
	org.awaitility;version='[4.2.0,4.2.1)',\
	org.hamcrest;version='[2.2.0,2.2.1)',\
	org.mockito.mockito-core;version='[4.6.1,4.6.2)',\
	org.objenesis;version='[3.2.0,3.2.1)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.impl.bundle.annotations;version='[2.0.1,2.0.2)',\
	org.osgi.test.assertj.framework;version='[1.2.0,1.2.1)',\
	org.osgi.test.cases.bundle.annotations;version='[2.0.1,2.0.2)',\
	org.osgi.test.common;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit4;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit5;version='[1.2.0,1.2.1)'
